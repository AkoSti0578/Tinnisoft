    <string name="fine_tune">Fine-tuning</string>
    <string name="fine_tune_hint">½ = a semitone, − and + are very small steps.</string>
    <string name="octave_title">Step 2: octave check</string>
    <string name="octave_text">Tones an octave apart are often confused. Listen to the three options and choose the one most like your tinnitus.</string>
    <string name="octave_lower">One octave lower (%1$s)</string>
    <string name="octave_same">Chosen tone (%1$s)</string>
    <string name="octave_higher">One octave higher (%1$s)</string>
    <string name="octave_confirm">This one is closest</string>
    <string name="result_title">Step 3: result</string>
    <string name="result_text">This frequency will be saved. You can repeat the matcher any time, for example at another time of day.</string>
