    <string name="matcher_title">Find your tinnitus frequency</string>
    <string name="matcher_intro">Sit in a quiet room and preferably use headphones. You will hear a tone. Move the pitch until it resembles your tinnitus as closely as possible.\n\nThe tone always starts softly. Never make it louder than needed.</string>
    <string name="matcher_tone_type">Tone type</string>
    <string name="tone_sine">Pure tone</string>
    <string name="tone_narrowband">Narrow-band noise</string>
    <string name="matcher_tone_type_hint">If your tinnitus sounds like a whistle, choose a pure tone. If it sounds more like hissing, choose narrow-band noise.</string>
    <string name="matcher_search_title">Step 1: find the pitch</string>
    <string name="matcher_search_text">Turn on the tone and slide roughly to the right pitch. Then fine-tune with the buttons.</string>
    <string name="play_tone">Play tone</string>
    <string name="tone_starts_soft">Starts softly and slowly becomes audible</string>
    <string name="tone_volume">Tone volume</string>
