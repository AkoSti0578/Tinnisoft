    <!-- Frequentie-matcher -->
    <string name="matcher_title">Zoek je tinnitusfrequentie</string>
    <string name="matcher_intro">Ga in een rustige ruimte zitten en gebruik bij voorkeur een koptelefoon. Je hoort zo een toon. Verschuif de toonhoogte tot hij zo veel mogelijk lijkt op je tinnitus.\n\nDe toon begint altijd zacht. Zet hem nooit harder dan nodig.</string>
    <string name="matcher_tone_type">Soort toon</string>
    <string name="tone_sine">Zuivere toon</string>
    <string name="tone_narrowband">Smalband-ruis</string>
    <string name="matcher_tone_type_hint">Klinkt je tinnitus als een fluittoon, kies dan een zuivere toon. Klinkt hij meer als een sissend of ruisend geluid, kies dan smalband-ruis.</string>
    <string name="matcher_search_title">Stap 1: toonhoogte zoeken</string>
    <string name="matcher_search_text">Zet de toon aan en schuif grof naar de juiste hoogte. Stem daarna fijn af met de knoppen.</string>
    <string name="play_tone">Toon afspelen</string>
    <string name="tone_starts_soft">Begint zacht en wordt langzaam hoorbaar</string>
    <string name="tone_volume">Volume van de toon</string>
    <string name="frequency">Frequentie</string>
    <string name="coarse">Grof</string>
    <string name="fine_tune">Fijnafstemming</string>
    <string name="fine_tune_hint">½ = een halve toon, − en + zijn heel kleine stapjes.</string>
    <string name="octave_title">Stap 2: octaaf-check</string>
    <string name="octave_text">Tonen die een octaaf verschillen worden vaak met elkaar verward. Luister naar de drie opties en kies welke het meest op je tinnitus lijkt.</string>
    <string name="octave_lower">Een octaaf lager (%1$s)</string>
    <string name="octave_same">Gekozen toon (%1$s)</string>
    <string name="octave_higher">Een octaaf hoger (%1$s)</string>
    <string name="octave_confirm">Deze lijkt het meest</string>
    <string name="result_title">Stap 3: resultaat</string>
    <string name="result_text">Deze frequentie wordt opgeslagen. Je kunt de matcher altijd opnieuw doen, bijvoorbeeld op een ander moment van de dag.</string>
    <string name="apply_notch">Gebruiken voor notched ruis en smalband-ruis</string>
    <string name="apply_eq">Equalizer afstemmen</string>
    <string name="apply_eq_hint">Versterkt de band rond je tinnitus een beetje.</string>

